# Copiá este archivo a .env.prod y completalo. .env.prod NO se sube a git.
# Generar claves:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"

# Dominio o IP por la que se entra (sin https://). Ej: mooping.tucampo.com o 192.168.1.50
SITE_HOST=
# "internal" = certificado propio (red local). Con un dominio público, poné tu email
# para un certificado de Let's Encrypt (requiere los puertos 80 y 443 abiertos).
CADDY_TLS=internal
# Con certificado real, activar HSTS (los navegadores recuerdan usar siempre https):
SECURE_HSTS_SECONDS=0

DJANGO_SECRET_KEY=
POSTGRES_PASSWORD=
# La misma en la Pi: TELEMETRY_KEY=... (ver firmware/AgroBot/firmware/README.md)
TELEMETRY_API_KEY=

# Opcionales: soporte técnico por email (ver README)
SUPPORT_EMAIL=
EMAIL_HOST=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
