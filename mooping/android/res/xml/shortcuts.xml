<?xml version="1.0" encoding="utf-8"?>
<!-- Mantener apretado el ícono → "Cambiar servidor". -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="cambiar_servidor"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/shortcut_server">
        <intent
            android:action="app.mooping.SETUP"
            android:targetPackage="app.mooping"
            android:targetClass="app.mooping.MainActivity" />
    </shortcut>
</shortcuts>
