<?xml version="1.0" encoding="utf-8"?>
<!-- MooPing en la red local se sirve por http (ej. http://192.168.1.50:5173). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
